<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NEXUS iNFINITY | Marketing & Inovação</title>

    <link rel="stylesheet" href="style.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- ===== HEADER ===== -->
    <header>
        <div class="logo">
            <h1>NEXUS <span>iNFINITY</span></h1>
        </div>

        <nav>
            <ul>
                <li><a href="#inicio">Início</a></li>
                <li><a href="#equipe">Equipe</a></li>
                <li><a href="#responsabilidades">Responsabilidades</a></li>
                <li><a href="#objetivo">Objetivo</a></li>
                <li><a href="#atividades">Atividades</a></li>
                <li><a href="#resultado">Resultados</a></li>
            </ul>
        </nav>
    </header>

    <!-- ===== HERO ===== -->
    <section class="hero" id="inicio">

        <div class="hero-text">

            <h2>Conectando ideias.<br>Construindo o futuro digital.</h2>

            <p>
                A NEXUS iNFINITY é uma empresa de tecnologia e marketing digital focada em desenvolver soluções inovadoras,
                estratégicas e escaláveis para o mundo moderno.
            </p>

            <p>
                Atuamos na criação de marcas fortes, experiências digitais impactantes e estratégias de crescimento
                que conectam pessoas, dados e tecnologia.
            </p>

            <a href="#equipe" class="botao">Conheça nossa equipe</a>

        </div>

    </section>

    <!-- ===== EQUIPE ===== -->
    <section id="equipe" class="container">

        <h2>Nossa Equipe</h2>

        <div class="cards">

            <div class="card" onclick="abrirModal('arthur')">
                <h3>Arthur</h3>
                <p>Marketing Estratégico</p>
            </div>

            <div class="card" onclick="abrirModal('maria')">
                <h3>Maria Clara</h3>
                <p>Identidade Visual</p>
            </div>

            <div class="card" onclick="abrirModal('rebeca')">
                <h3>Rebeca Sofia</h3>
                <p>Comunicação</p>
            </div>

            <div class="card" onclick="abrirModal('raphaella')">
                <h3>Raphaella</h3>
                <p>Branding</p>
            </div>

            <div class="card" onclick="abrirModal('brendha')">
                <h3>Brendha</h3>
                <p>Pesquisa de Mercado</p>
            </div>

        </div>

    </section>

    <!-- ===== RESPONSABILIDADES ===== -->
    <section id="responsabilidades" class="container">

        <h2>Responsabilidades</h2>

        <p class="texto">
            O setor de Marketing da NEXUS iNFINITY é responsável por construir, fortalecer e posicionar a marca no mercado digital.
            Atuamos com estratégias criativas e tecnológicas para gerar impacto e reconhecimento.
        </p>

        <div class="info">
            <ul>
                <li> Desenvolvimento de identidade visual e branding</li>
                <li> Criação de slogan e posicionamento da marca</li>
                <li> Estratégias de endomarketing</li>
                <li> Pesquisa de mercado e benchmarking</li>
                <li> Planejamento de comunicação digital</li>
            </ul>
        </div>

    </section>

    <!-- ===== OBJETIVO ===== -->
    <section id="objetivo" class="container">

        <h2>Objetivo</h2>

        <p class="texto">
            Nosso objetivo é criar uma marca inovadora e relevante no mercado digital,
            utilizando tecnologia e criatividade para desenvolver soluções inteligentes que gerem valor real.
        </p>

    </section>

    <!-- ===== ATIVIDADES ===== -->
    <section id="atividades" class="container">

        <h2>Atividades Realizadas</h2>

        <p class="texto">
            Realizamos reuniões para definição da identidade da empresa, criação do nome, escolha de cores,
            desenvolvimento do slogan e construção das estratégias de marketing.
        </p>

        <p class="texto">
            Todo o processo foi guiado por análise de mercado, criatividade e trabalho em equipe.
        </p>

    </section>

    <!-- ===== RESULTADOS ===== -->
    <section id="resultado" class="container">

        <h2>Resultados</h2>

        <p class="texto">
            O projeto resultou na criação completa da identidade da NEXUS iNFINITY,
            incluindo missão, visão, valores, branding e posicionamento estratégico.
        </p>

        <p class="texto">
            Também desenvolvemos habilidades importantes como colaboração, comunicação e pensamento estratégico.
        </p>

    </section>

    <!-- ===== MODAIS ===== -->

    <!-- ARTHUR -->
    <div id="modal-arthur" class="modal">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2>Marketing Estratégico</h2>
            <p>
                Responsável por planejar ações de longo prazo para posicionar a empresa no mercado.
                Analisa público-alvo, concorrência e tendências para criar estratégias eficientes de crescimento.
            </p>
        </div>
    </div>

    <!-- MARIA -->
    <div id="modal-maria" class="modal">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2>Identidade Visual</h2>
            <p>
                Define a aparência da marca, incluindo cores, logotipo e estilo visual.
                Garante consistência e reconhecimento da empresa no mercado.
            </p>
        </div>
    </div>

    <!-- REBECA -->
    <div id="modal-rebeca" class="modal">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2>Comunicação</h2>
            <p>
                Responsável por transmitir a mensagem da empresa de forma clara e estratégica,
                conectando a marca ao público-alvo.
            </p>
        </div>
    </div>

    <!-- RAPHAELLA -->
    <div id="modal-raphaella" class="modal">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2>Branding</h2>
            <p>
                Construção da identidade da marca, trabalhando valores, percepção e posicionamento emocional no mercado.
            </p>
        </div>
    </div>

    <!-- BRENDHA -->
    <div id="modal-brendha" class="modal">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2>Pesquisa de Mercado</h2>
            <p>
                Analisa consumidores, concorrentes e tendências para orientar decisões estratégicas da empresa.
            </p>
        </div>
    </div>

    <!-- ===== SCRIPT ===== -->
    <script>
        function abrirModal(nome) {
            document.getElementById("modal-" + nome).style.display = "flex";
        }

        function fecharModal() {
            document.querySelectorAll(".modal").forEach(m => {
                m.style.display = "none";
            });
        }

        window.onclick = function (event) {
            document.querySelectorAll(".modal").forEach(m => {
                if (event.target == m) {
                    m.style.display = "none";
                }
            });
        }
    </script>

</body>
</html>